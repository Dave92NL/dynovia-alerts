# Copy to .env for local development. In GitHub Actions these come from
# Settings -> Secrets and variables -> Actions, never from a file.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional, phase 5 (automatic assist suggestions). Works without it.
LLM_API_KEY=

# Web push (Faza 7). Bez nich aplikacja dziala tak samo, tylko bez push.
# Klucze generuje scripts/vapid.py, subskrypcje daje strona po kliknieciu
# "Wlacz powiadomienia" na zakladce Zrodla.
VAPID_PRIVATE_KEY=
# Adres kontaktowy dla uslugi push, w formie mailto:...
VAPID_SUBJECT=
PUSH_SUBSCRIPTION=
